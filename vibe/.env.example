# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env

# ---- Flask ----
# Chuỗi ngẫu nhiên, tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# 1 = bật debug khi chạy bằng "flask run"
FLASK_DEBUG=1

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=guestbook
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=guestbook
